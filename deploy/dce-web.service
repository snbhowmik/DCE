[Unit]
Description=Biokraft DCE dashboard (Next.js)
After=network.target dce-api.service

[Service]
User=dce
WorkingDirectory=/opt/dce/frontend
Environment=NODE_ENV=production DCE_API_URL=http://127.0.0.1:8000 PORT=3000 HOSTNAME=127.0.0.1
ExecStart=/opt/dce/frontend/node_modules/.bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
